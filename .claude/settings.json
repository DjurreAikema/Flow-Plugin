{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/cloud-setup.sh\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "flow@ai-workflow": true
  },
  "extraKnownMarketplaces": {
    "ai-workflow": {
      "source": {
        "source": "directory",
        "path": "./"
      }
    }
  }
}