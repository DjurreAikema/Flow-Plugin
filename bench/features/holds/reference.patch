diff --git a/test/holds.test.ts b/test/holds.test.ts
new file mode 100644
index 0000000..0cad427
--- /dev/null
+++ b/test/holds.test.ts
@@ -0,0 +1,125 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { Catalog } from "../src/catalog.ts";
+import { FeeLedger } from "../src/fees.ts";
+import { HoldError, HoldService } from "../src/holds.ts";
+import { LoanService } from "../src/loans.ts";
+import { MemberRegistry } from "../src/members.ts";
+import { holdsReportRows } from "../src/reports.ts";
+
+function makeWorld() {
+  const catalog = new Catalog();
+  const members = new MemberRegistry();
+  const holds = new HoldService(catalog, members);
+  const loans = new LoanService(catalog, members, new FeeLedger(), holds);
+  catalog.addBook({ id: "b1", title: "Dune", author: "Frank Herbert", year: 1965 });
+  catalog.addCopy("b1", "2024-01-01");
+  for (const [id, name] of [["m1", "Alice"], ["m2", "Bob"], ["m3", "Carol"]] as const) {
+    members.register({ id, name, email: `${id}@example.com`, joined: "2024-01-01" });
+  }
+  return { catalog, members, holds, loans };
+}
+
+describe("holds: placing", () => {
+  it("refuses a hold while a copy is available", () => {
+    const { holds } = makeWorld();
+    assert.throws(() => holds.placeHold("m1", "b1", "2024-06-01"), HoldError);
+  });
+
+  it("queues holds in order and numbers them from 1", () => {
+    const { holds, loans } = makeWorld();
+    loans.checkout("m1", "b1", "2024-06-01");
+    const first = holds.placeHold("m2", "b1", "2024-06-02");
+    const second = holds.placeHold("m3", "b1", "2024-06-03");
+    assert.equal(first.id, "H1");
+    assert.equal(first.status, "waiting");
+    assert.deepEqual(holds.queue("b1").map((hold) => hold.id), ["H1", "H2"]);
+    assert.equal(holds.position(second.id), 2);
+  });
+
+  it("refuses a second hold, a hold on a loaned book and a suspended member", () => {
+    const { holds, loans, members } = makeWorld();
+    loans.checkout("m1", "b1", "2024-06-01");
+    holds.placeHold("m2", "b1", "2024-06-02");
+    assert.throws(() => holds.placeHold("m2", "b1", "2024-06-02"), HoldError);
+    assert.throws(() => holds.placeHold("m1", "b1", "2024-06-02"), HoldError);
+    members.suspend("m3", "test");
+    assert.throws(() => holds.placeHold("m3", "b1", "2024-06-02"), HoldError);
+  });
+
+  it("refuses a hold over the limit of the tier", () => {
+    const { catalog, holds, loans, members } = makeWorld();
+    members.register({ id: "m4", name: "Dan", email: "dan@example.com", joined: "2024-01-01" });
+    for (let index = 0; index < 4; index += 1) {
+      catalog.addBook({ id: `x${index}`, title: `X${index}`, author: "A", year: 2000 });
+      catalog.addCopy(`x${index}`, "2024-01-01");
+      loans.checkout("m1", `x${index}`, "2024-06-01");
+    }
+    for (let index = 0; index < 3; index += 1) holds.placeHold("m4", `x${index}`, "2024-06-02");
+    assert.throws(() => holds.placeHold("m4", "x3", "2024-06-02"), HoldError);
+  });
+});
+
+describe("holds: return, checkout, cancel and expiry", () => {
+  it("keeps a returned copy for the first waiting hold", () => {
+    const { catalog, holds, loans } = makeWorld();
+    const loan = loans.checkout("m1", "b1", "2024-06-01");
+    holds.placeHold("m2", "b1", "2024-06-02");
+    loans.returnCopy(loan.id, "2024-06-05");
+    const hold = holds.getHold("H1");
+    assert.equal(hold.status, "ready");
+    assert.equal(hold.copyId, "b1-c1");
+    assert.equal(hold.readyUntil, "2024-06-08");
+    assert.equal(catalog.getCopy("b1-c1").status, "on-hold");
+    assert.throws(() => loans.checkout("m3", "b1", "2024-06-06"));
+  });
+
+  it("lends the held copy to the member and fulfils the hold", () => {
+    const { catalog, holds, loans } = makeWorld();
+    const loan = loans.checkout("m1", "b1", "2024-06-01");
+    holds.placeHold("m2", "b1", "2024-06-02");
+    loans.returnCopy(loan.id, "2024-06-05");
+    assert.equal(loans.checkout("m2", "b1", "2024-06-06").copyId, "b1-c1");
+    assert.equal(holds.getHold("H1").status, "fulfilled");
+    assert.equal(catalog.getCopy("b1-c1").status, "on-loan");
+  });
+
+  it("passes a cancelled ready hold to the next one, then frees the copy", () => {
+    const { catalog, holds, loans } = makeWorld();
+    const loan = loans.checkout("m1", "b1", "2024-06-01");
+    holds.placeHold("m2", "b1", "2024-06-02");
+    holds.placeHold("m3", "b1", "2024-06-03");
+    loans.returnCopy(loan.id, "2024-06-05");
+    holds.cancelHold("H1", "2024-06-06");
+    assert.equal(holds.getHold("H2").status, "ready");
+    holds.cancelHold("H2", "2024-06-06");
+    assert.equal(catalog.getCopy("b1-c1").status, "available");
+    assert.throws(() => holds.cancelHold("H2", "2024-06-06"), HoldError);
+  });
+
+  it("expires a late ready hold and returns it", () => {
+    const { catalog, holds, loans } = makeWorld();
+    const loan = loans.checkout("m1", "b1", "2024-06-01");
+    holds.placeHold("m2", "b1", "2024-06-02");
+    loans.returnCopy(loan.id, "2024-06-05");
+    assert.deepEqual(holds.expireHolds("2024-06-08"), []);
+    assert.deepEqual(holds.expireHolds("2024-06-09").map((hold) => hold.id), ["H1"]);
+    assert.equal(catalog.getCopy("b1-c1").status, "available");
+    assert.equal(holds.position("H1"), null);
+  });
+});
+
+describe("holds: report", () => {
+  it("lists waiting and ready holds, ready first", () => {
+    const { catalog, members, holds, loans } = makeWorld();
+    const loan = loans.checkout("m1", "b1", "2024-06-01");
+    holds.placeHold("m2", "b1", "2024-06-02");
+    holds.placeHold("m3", "b1", "2024-06-03");
+    loans.returnCopy(loan.id, "2024-06-05");
+    const rows = holdsReportRows(holds.allHolds(), catalog, members, "2024-06-06");
+    assert.deepEqual(rows.map((row) => [row.memberName, row.status, row.position, row.readyUntil]), [
+      ["Bob", "ready", 0, "2024-06-08"],
+      ["Carol", "waiting", 1, ""],
+    ]);
+  });
+});
