new file mode 100644
index 0000000..1afbda8
--- /dev/null
+++ b/src/holds.ts
@@ -0,0 +1,194 @@
+/**
+ * Holds: a member waits for a copy of a book that has no available copy.
+ *
+ * A hold is waiting until a copy comes back. The returned copy is kept for the
+ * first waiting hold, which becomes ready for 3 days. The member then borrows
+ * the held copy, or the hold is cancelled or expires and the copy moves on.
+ */
+
+import type { Catalog } from "./catalog.ts";
+import { addDays, isBefore, isValidDate } from "./dates.ts";
+import type { IsoDate } from "./dates.ts";
+import type { LoanService } from "./loans.ts";
+import type { MemberRegistry } from "./members.ts";
+
+/** The error that the hold service throws for bad input or a refused hold. */
+export class HoldError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "HoldError";
+  }
+}
+
+/** The days that a ready hold keeps its copy. */
+export const READY_DAYS = 3;
+
+export type HoldStatus = "waiting" | "ready" | "fulfilled" | "cancelled" | "expired";
+
+/** A request of a member for a book. */
+export interface Hold {
+  id: string;
+  memberId: string;
+  bookId: string;
+  placed: IsoDate;
+  status: HoldStatus;
+  copyId?: string;
+  readyUntil?: IsoDate;
+}
+
+function requireToday(today: IsoDate): void {
+  if (!isValidDate(today)) {
+    throw new HoldError(`Invalid date: ${String(today)}`);
+  }
+}
+
+function cloneHold(hold: Hold): Hold {
+  return { ...hold };
+}
+
+export class HoldService {
+  private readonly catalog: Catalog;
+  private readonly members: MemberRegistry;
+  private readonly holds = new Map<string, Hold>();
+  private loans: LoanService | undefined;
+  private nextId = 1;
+
+  constructor(catalog: Catalog, members: MemberRegistry) {
+    this.catalog = catalog;
+    this.members = members;
+  }
+
+  /** Called by a LoanService that gets this service, so that a hold can see the loans. */
+  attachLoans(loans: LoanService): void {
+    this.loans = loans;
+  }
+
+  placeHold(memberId: string, bookId: string, today: IsoDate): Hold {
+    requireToday(today);
+    if (!this.members.has(memberId)) {
+      throw new HoldError(`Unknown member id: ${memberId}`);
+    }
+    if (!this.catalog.hasBook(bookId)) {
+      throw new HoldError(`Unknown book id: ${bookId}`);
+    }
+    if (this.members.get(memberId).status === "suspended") {
+      throw new HoldError(`Member ${memberId} is suspended`);
+    }
+    if (this.catalog.availableCopies(bookId).length > 0) {
+      throw new HoldError(`A copy of book ${bookId} is available. Borrow it instead`);
+    }
+    if (this.open(memberId).some((hold) => hold.bookId === bookId)) {
+      throw new HoldError(`Member ${memberId} has a hold on book ${bookId} already`);
+    }
+    if (this.loans?.activeLoans(memberId).some((loan) => loan.bookId === bookId)) {
+      throw new HoldError(`Member ${memberId} has book ${bookId} on loan`);
+    }
+    const limit = this.members.rulesFor(memberId).maxHolds;
+    if (this.open(memberId).length >= limit) {
+      throw new HoldError(`Member ${memberId} has ${limit} holds already`);
+    }
+    const hold: Hold = {
+      id: `H${this.nextId}`,
+      memberId,
+      bookId,
+      placed: today,
+      status: "waiting",
+    };
+    this.nextId += 1;
+    this.holds.set(hold.id, hold);
+    return cloneHold(hold);
+  }
+
+  cancelHold(holdId: string, today: IsoDate): Hold {
+    requireToday(today);
+    const hold = this.require(holdId);
+    if (hold.status !== "waiting" && hold.status !== "ready") {
+      throw new HoldError(`Hold ${holdId} is ${hold.status}`);
+    }
+    const wasReady = hold.status === "ready";
+    hold.status = "cancelled";
+    if (wasReady) {
+      this.release(hold.copyId as string, hold.bookId, today);
+    }
+    return cloneHold(hold);
+  }
+
+  /** Expire each ready hold that is past its date, and pass its copy on. */
+  expireHolds(today: IsoDate): Hold[] {
+    requireToday(today);
+    const late = [...this.holds.values()].filter(
+      (hold) => hold.status === "ready" && isBefore(hold.readyUntil as IsoDate, today),
+    );
+    for (const hold of late) {
+      hold.status = "expired";
+      this.release(hold.copyId as string, hold.bookId, today);
+    }
+    return late.map(cloneHold);
+  }
+
+  getHold(holdId: string): Hold {
+    return cloneHold(this.require(holdId));
+  }
+
+  allHolds(): Hold[] {
+    return [...this.holds.values()].map(cloneHold);
+  }
+
+  /** The waiting holds of a book, in the order of placement. */
+  queue(bookId: string): Hold[] {
+    return [...this.holds.values()]
+      .filter((hold) => hold.bookId === bookId && hold.status === "waiting")
+      .map(cloneHold);
+  }
+
+  /** The 1-based place of a waiting hold in its queue, or null. */
+  position(holdId: string): number | null {
+    const hold = this.require(holdId);
+    if (hold.status !== "waiting") return null;
+    return this.queue(hold.bookId).findIndex((entry) => entry.id === holdId) + 1;
+  }
+
+  /** The ready hold of a member on a book, if any. Used by LoanService.checkout. */
+  readyHoldOf(memberId: string, bookId: string): Hold | undefined {
+    const hold = [...this.holds.values()].find(
+      (entry) => entry.memberId === memberId && entry.bookId === bookId && entry.status === "ready",
+    );
+    return hold === undefined ? undefined : cloneHold(hold);
+  }
+
+  /** Mark a ready hold as fulfilled. Used by LoanService.checkout. */
+  fulfill(holdId: string): void {
+    this.require(holdId).status = "fulfilled";
+  }
+
+  /**
+   * Give a free copy to the first waiting hold of its book, or make it
+   * available when no hold waits. Used by LoanService.returnCopy.
+   */
+  release(copyId: string, bookId: string, today: IsoDate): void {
+    const next = this.queue(bookId)[0];
+    if (next === undefined) {
+      this.catalog.setCopyStatus(copyId, "available");
+      return;
+    }
+    const hold = this.require(next.id);
+    hold.status = "ready";
+    hold.copyId = copyId;
+    hold.readyUntil = addDays(today, READY_DAYS);
+    this.catalog.setCopyStatus(copyId, "on-hold");
+  }
+
+  private open(memberId: string): Hold[] {
+    return [...this.holds.values()].filter(
+      (hold) => hold.memberId === memberId && (hold.status === "waiting" || hold.status === "ready"),
+    );
+  }
+
+  private require(holdId: string): Hold {
+    const hold = this.holds.get(holdId);
+    if (hold === undefined) {
+      throw new HoldError(`Unknown hold id: ${holdId}`);
+    }
+    return hold;
+  }
+}
