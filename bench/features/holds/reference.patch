+
+/** One line of the holds report. */
+export interface HoldsRow {
+  title: string;
+  memberName: string;
+  status: string;
+  position: number;
+  readyUntil: string;
+}
+
+/**
+ * List the waiting and the ready holds. A ready hold has position 0. A waiting
+ * hold has its 1-based place among the waiting holds of its book, in the order
+ * of the input. Sorted by title, then by position. Equal rows keep their order.
+ */
+export function holdsReportRows(
+  holds: Hold[],
+  catalog: Catalog,
+  members: MemberRegistry,
+  today: IsoDate,
+): HoldsRow[] {
+  if (!isValidDate(today)) {
+    throw new ReportError(`Invalid date: ${String(today)}`);
+  }
+  const waiting = new Map<string, number>();
+  const rows: HoldsRow[] = [];
+  for (const hold of holds) {
+    if (hold.status !== "waiting" && hold.status !== "ready") continue;
+    let position = 0;
+    if (hold.status === "waiting") {
+      position = (waiting.get(hold.bookId) ?? 0) + 1;
+      waiting.set(hold.bookId, position);
+    }
+    rows.push({
+      title: catalog.getBook(hold.bookId).title,
+      memberName: members.get(hold.memberId).name,
+      status: hold.status,
+      position,
+      readyUntil: hold.readyUntil ?? "",
+    });
+  }
+  return rows.sort((a, b) => a.title.localeCompare(b.title) || a.position - b.position);
+}
