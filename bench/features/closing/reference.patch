diff --git a/test/closing.test.ts b/test/closing.test.ts
new file mode 100644
index 0000000..0809de9
--- /dev/null
+++ b/test/closing.test.ts
@@ -0,0 +1,62 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { Catalog } from "../src/catalog.ts";
+import { FeeLedger } from "../src/fees.ts";
+import { LoanError, LoanService } from "../src/loans.ts";
+import { MemberError, MemberRegistry } from "../src/members.ts";
+
+function makeWorld() {
+  const catalog = new Catalog();
+  const members = new MemberRegistry();
+  const ledger = new FeeLedger();
+  const loans = new LoanService(catalog, members, ledger);
+  catalog.addBook({ id: "b1", title: "Dune", author: "Frank Herbert", year: 1965 });
+  catalog.addCopy("b1", "2024-01-01");
+  members.register({ id: "m1", name: "Carol", email: "carol@example.com", joined: "2024-01-01" });
+  return { members, ledger, loans };
+}
+
+describe("loans: closing an account", () => {
+  it("closes the account and records the date", () => {
+    const { members, loans } = makeWorld();
+    const member = loans.closeAccount("m1", "2024-06-20");
+    assert.equal(member.status, "closed");
+    assert.equal(members.get("m1").closed, "2024-06-20");
+  });
+
+  it("refuses an active loan, a high balance and a second close", () => {
+    const { ledger, loans } = makeWorld();
+    const loan = loans.checkout("m1", "b1", "2024-06-01");
+    assert.throws(() => loans.closeAccount("m1", "2024-06-20"), LoanError);
+    loans.reportLost(loan.id, "2024-06-10");
+    assert.throws(() => loans.closeAccount("m1", "2024-06-20"), LoanError);
+    ledger.pay("m1", 1800, "2024-06-11");
+    loans.closeAccount("m1", "2024-06-20");
+    assert.throws(() => loans.closeAccount("m1", "2024-06-21"), LoanError);
+    assert.throws(() => loans.checkout("m1", "b1", "2024-06-21"), LoanError);
+  });
+
+  it("writes off a small balance with a new ledger entry", () => {
+    const { ledger, loans } = makeWorld();
+    ledger.charge("m1", 300, "late return", "2024-06-10");
+    loans.closeAccount("m1", "2024-06-20");
+    const entries = ledger.entries("m1");
+    assert.equal(entries.length, 2);
+    assert.equal(entries[1]?.kind, "write-off");
+    assert.equal(entries[1]?.cents, -300);
+    assert.equal(ledger.balance("m1"), 0);
+  });
+
+  it("adds no write-off for a balance of 0", () => {
+    const { ledger } = makeWorld();
+    assert.equal(ledger.writeOff("m1", "2024-06-20"), undefined);
+    assert.equal(ledger.entries("m1").length, 0);
+  });
+
+  it("refuses to suspend or reactivate a closed member", () => {
+    const { members, loans } = makeWorld();
+    loans.closeAccount("m1", "2024-06-20");
+    assert.throws(() => members.suspend("m1", "fees"), MemberError);
+    assert.throws(() => members.reactivate("m1"), MemberError);
+  });
+});
